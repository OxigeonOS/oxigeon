# Build output
/target

# The live trees the server loads — a creator's own game and mudlib, brought in
# from their own repo and deliberately invisible to this one.
#
# What this repository ships and tests is the pair beside them, `game.example/`
# and `mudlib.default/`, which are tracked. So a change meant for upstream is
# made *there*: it is the only copy the test suite or a reviewer ever sees, and
# anything left only in `mudlib/` is unpublishable by construction.
game/
mudlib/

# Database files
oxigeon.db
*.db-journal
*.db-shm
*.db-wal

# Runtime logs (generated on server start)
logs/

# Secrets / local env
.env
.env.local

# Editor artifacts
# Note: this must be `.vscode/*`, not `.vscode/`. Git never descends into an
# excluded *directory*, so negations below a bare `.vscode/` are silently
# ignored and the shared debug config would never be committed.
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
