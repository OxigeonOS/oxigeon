# Build output
/target

# Game and Mudlib dirs
game/
mudlib/

# Database files
oxigeon.db
*.db-journal
*.db-shm
*.db-wal

# Runtime logs (generated on server start)
logs/

# Secrets / local env
.env
.env.local

# Editor artifacts
# Note: this must be `.vscode/*`, not `.vscode/`. Git never descends into an
# excluded *directory*, so negations below a bare `.vscode/` are silently
# ignored and the shared debug config would never be committed.
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
